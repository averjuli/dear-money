{
  "name": "dear-money",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed-cli.ts",
    "auth:setup": "tsx scripts/auth-setup.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
